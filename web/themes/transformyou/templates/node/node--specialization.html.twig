{# The render node of view Specialization #}
<div class="container_specialization">
    <div class="specialization__content glass">
        <div class="specialization__icon">
            <img
                src="{{ file_url(node.field_icon.entity.uri.value) }}" 
                alt="{{ node.field_icon.alt }}" 
                class="specialization__icon"
            />
            </div>
        <div class="specialization__title">
            {{ node.label }}
        </div>
        <div class="specialization__body">{{ content.body }}</div>
    </div>
    <div class="specialization__visual glass">
        <div class="field_documents">
            {% if node.field_documents.entity is defined %}
                <img
                    src="{{ file_url(node.field_documents.entity.uri.value) }}" 
                    alt="{{ node.field_documents.alt }}" 
                    class="specialization__image"
                />
            {% endif %}
        </div>
  </div>
</div>
