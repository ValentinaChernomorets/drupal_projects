<div class="language-switcher-wrapper">
  <div class="selected-language"> 
    {% if current_lang == 'ru' %}
      RU
    {% elseif current_lang == 'en-gb' %}
      EN
    {% elseif current_lang == 'ro' %}
      RO
    {% endif %}
  </div>
    <ul class="language-switcher">
      <li class="flag-option" data-value="/">RU</li>
      <li class="flag-option" data-value="/en-gb">EN</li>
      <li class="flag-option" data-value="/ro">RO</li>
    </ul>
</div>