{# The Render Home page #}


{% set classes = [
  'block',
  'block-' ~ configuration.provider|clean_class,
  'block-' ~ plugin_id|clean_class,
  'page-hero',
] %}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  <div class="page-hero__container container">
    {% block content %}
      <div class="page-hero__content">
        <div class="page-hero__group">
            <div class="page-hero__sub-title">
              {{ content.field_sub_title|without('#theme')}}
            </div>
            <h1 class="page-hero__title">
                {{ content.field_text_formatted|without('#theme') }}
            </h1>
            <div class="page-hero__text">
                {{ content.body|without('#theme') }}
            </div>
            <div class="page-hero__stats">
                {% for item in content.field_hero_stats|children %}
                    {{ item }}
                {% endfor %}
            </div>
            <div class="page-hero__actions">
              {% if content.field_link_m %}
                {% for item in content.field_link_m|children %}
                  <a href="{{ item.field_link_m[0]['#url'] }}" class="cta-button{% if loop.index == 2 %} secondary{% endif %}">
                    {{ item['#title'] }}
                  </a>
                {% endfor %}
              {% endif %}  
            </div>
        </div>
      </div>
    {% endblock %}
  </div>
</div>